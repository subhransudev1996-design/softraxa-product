# Copy this file to .env and fill in your Supabase project values
# (Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
# The website (no trailing slash), e.g. https://www.softraxa.in
# Password-reset and signup emails open <WEBSITE_URL>/auth/callback.
# Add that address under Supabase → Authentication → URL Configuration →
# Redirect URLs.
WEBSITE_URL=YOUR-ANON-KEY

# Push notifications (optional — leave blank to disable).
# Firebase Console -> Project settings -> General -> Your apps (Android app)
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_SENDER_ID=
FIREBASE_PROJECT_ID=

# Crash reporting (optional — leave blank to disable).
# Sentry -> Project settings -> Client Keys (DSN). The DSN is not a secret.
# Never put the Sentry auth token here; it lives in sentry.properties (git-ignored).
SENTRY_DSN=
# Defaults to "production" in release builds and "debug" otherwise.
SENTRY_ENVIRONMENT=
